    "generate-cv": "./src/cv/compile.sh"
  },
  "dependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/vite": "^4.1.5",
    "@tsparticles/engine": "^3.8.1",
    "@tsparticles/react": "^3.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsparticles": "^3.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.5",
    "@types/node": "^22.15.24",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.4",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.3",
    "puppeteer": "^24.9.0",
    "sharp": "^0.34.2",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.8.3",
