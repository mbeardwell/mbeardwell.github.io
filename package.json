{
  "name": "temp",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run generate-cv",
    "preview": "vite preview",
    "clean-install": "rm -rf node_modules/ dist/ package-lock.json && npm install",
